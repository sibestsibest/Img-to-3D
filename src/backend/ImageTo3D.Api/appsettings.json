{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Storage": {
    "RootPath": "../../../data/storage",
    "DatabasePath": "../../../data/imageto3d.db",
    "DesignRootPath": "../../../data/designs",
    "ReferenceRootPath": "../../../data/references",
    "ReferenceCachePath": "../../../data/reference-cache",
    "RetentionPeriod": "7.00:00:00",
    "CleanupInterval": "01:00:00",
    "OrphanGracePeriod": "01:00:00"
  },
  "Upload": {
    "MaxBytes": 20971520,
    "MinDimension": 64,
    "MaxDimension": 8192,
    "MaxPixels": 40000000,
    "MaxActiveJobsPerOwner": 3,
    "UploadsPerMinute": 10,
    "MaxExtraImages": 5
  },
  "InferenceService": {
    "BaseUrl": "http://127.0.0.1:5090",
    "ApiKey": "",
    "RequestTimeout": "00:01:00",
    "PollInterval": "00:00:01.500",
    "GenerationTimeout": "00:40:00",
    "MaxConsecutivePollFailures": 20
  },
  "PartDesign": {
    "MaxSourceTriangles": 2000000,
    "MaxAnalysedParts": 64,
    "FragmentTriangleFraction": 0.002,
    "MaxPartsPerProject": 500,
    "MaxProjectsPerOwner": 100
  },
  "ReferenceSearch": {
    "WikimediaEnabled": true,
    "OpenverseEnabled": true,
    "InternetArchiveEnabled": true,
    "UserAgent": "ImageTo3D/0.4 (local reference search; .NET HttpClient)",
    "SourceTimeout": "00:00:12",
    "MaxRetries": 1,
    "ResultsPerSource": 20,
    "CacheTtl": "7.00:00:00",
    "MaxCandidatesPerSession": 300,
    "SearchesPerMinute": 10,
    "ThumbnailMaxBytes": 4194304,
    "ThumbnailMaxSide": 640,
    "DownloadConcurrency": 6,
    "NearDuplicateDistance": 6
  },
  "ModelOutput": {
    "DefaultLongestSideMm": 100
  }
}
