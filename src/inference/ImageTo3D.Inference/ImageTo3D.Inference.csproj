<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ONNX Runtime native build: Cpu (default, verified) or Cuda (dotnet build -p:OrtFlavor=Cuda; ORT 1.31 GPU needs CUDA 13 + cuDNN 9; started by scripts/dev.ps1 -Gpu). -->
    <OrtFlavor Condition="'$(OrtFlavor)' == ''">Cpu</OrtFlavor>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\ImageTo3D.Core\ImageTo3D.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" Condition="'$(OrtFlavor)' == 'Cpu'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" Condition="'$(OrtFlavor)' == 'Cuda'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageTo3D.Inference.Tests" />
  </ItemGroup>

</Project>
