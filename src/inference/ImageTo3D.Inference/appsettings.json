{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5090",
  "Inference": {
    "ModelDirectory": "../../../models",
    "TriplaneModel": "triposr/triplane.onnx",
    "NerfModel": "triposr/nerf.onnx",
    "BackgroundRemovalModel": "u2net/u2net.onnx",
    "WorkDirectory": "../../../data/inference",
    "ExecutionProvider": "Cpu",
    "IntraOpThreads": 0,
    "CpuLimit": 0.8,
    "MarchingCubesResolution": 256,
    "DensityThreshold": 25.0,
    "ForegroundRatio": 0.85,
    "ChunkSize": 262144,
    "KeepLargestComponentOnly": false,
    "MaxQueueLength": 8,
    "MaxImageBytes": 20971520,
    "JobTimeout": "00:30:00",
    "RetentionPeriod": "06:00:00",
    "CleanupInterval": "00:15:00",
    "ApiKey": "",
    "LoadModelsOnStartup": true
  }
}
