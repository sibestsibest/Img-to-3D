# Copy to .env (never commit .env). Used by docker-compose.yml.

# Shared secret between the API and the inference service (X-Internal-Api-Key header).
# Generate one with: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
INFERENCE_API_KEY=change-me-to-a-long-random-value

# How long finished jobs and their files are kept (d.hh:mm:ss).
RETENTION_PERIOD=7.00:00:00

# For non-Docker runs, any appsettings value can be overridden with environment variables
# using double underscores, e.g.:
#   $env:InferenceService__BaseUrl = "http://127.0.0.1:5090"
#   $env:Inference__ExecutionProvider = "Cuda"
#   $env:Inference__MarchingCubesResolution = "192"
#   $env:ModelOutput__DefaultLongestSideMm = "80"
